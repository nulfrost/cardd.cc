{
  "name": "cardd-cc",
  "main": "src/index.tsx",
  "compatibility_date": "2025-08-07",
  "kv_namespaces": [
    {
      "binding": "CARDD_KV",
      "id": "6cc8e4b4255c4f91bda5b32c6b8505b8",
      "preview_id": "5bb93eee024649acbf60b96c685b98cd"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "BADGE_ANALYTICS",
      "dataset": "badge_usage"
    }
  ],
  "ratelimits": [
    {
      "name": "BADGE_RATE_LIMITER",
